# Force LF line endings for all text files except Windows-only scripts.
# Prevents CRLF noise on commits (Windows default would otherwise flip LF↔CRLF).

# Kotlin & Gradle
*.kt          text eol=lf
*.kts         text eol=lf
*.java        text eol=lf

# JSON / XML / config
*.json        text eol=lf
*.xml         text eol=lf
*.toml        text eol=lf
*.properties  text eol=lf

# Markdown
*.md          text eol=lf

# Shell scripts: keep LF (they are executed by Git Bash / WSL on Windows too)
*.sh          text eol=lf
gradlew          text eol=lf

# Windows batch scripts must keep CRLF or Windows cmd will choke
*.bat         text eol=crlf

# Binary – no normalization
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico        binary
*.jar         binary
*.keystore    binary